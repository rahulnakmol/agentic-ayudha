set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { echo "==> [$(date +%H:%M:%S)] $*"; }
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n env "PATH=/usr/local/sbin:/usr/sbin:/sbin:$PATH" "$@"; fi; }
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]; }
in_ranges() { # version "lo [hi]"...: half-open ranges
  local v=$1 r lo hi
  shift
  for r in "$@"; do
    lo=${r%% *}; hi=
    [ "$r" = "$lo" ] || hi=${r#* }
    if version_ge "$v" "$lo" && { [ -z "$hi" ] || ! version_ge "$v" "$hi"; }; then return 0; fi
  done
  return 1
}
expect() { [ "$2" = "$3" ] || { echo "aayu-env: $1 is '$2', want '$3' (PATH=$PATH)" >&2; exit 1; }; }

expect go "$(GOTOOLCHAIN=local go env GOVERSION)" go1.27.2
in_ranges "$(node --version | sed 's/^v//')" "22.12.0 23.0.0" "24.0.0 25.0.0" "26.0.0" || { echo "aayu-env: node $(node --version) is outside ^22.12.0 || ^24.0.0 || >=26.0.0" >&2; exit 1; }
expect pnpm "$(pnpm --version)" 12.0.0
if [ "${1:-}" = --full ]; then
  # The local gate (Story #399): the CI jobs a pull request must pass, from .github/workflows/ci.yml and .github/workflows/protected-paths.yml.
  # git push runs it through the pre-push hook that `aayu install --env --apply` and .agents/setup install.
  # A git hook exports GIT_DIR and the like for its repository; tests that run git in a temporary directory would
  # then change this clone instead. The gate finds its repository from the working directory.
  unset $(git rev-parse --local-env-vars 2>/dev/null)
  GATE_TMP=$(mktemp -d)
  export GATE_TMP
  trap 'rm -rf "$GATE_TMP"' EXIT
  have() { command -v "$1" >/dev/null 2>&1 || { echo "aayu-gate: NOT RUN LOCALLY ($1 is not installed; CI runs it)"; return 1; }; }
  export -f have
  failed=()
  job() { # name commands...
    local name=$1 c
    shift
    for c in "$@"; do
      step "[ci: $name] $c"
      if ! bash -eo pipefail -c "$c"; then
        echo "aayu-gate: FAIL: CI job \"$name\" fails here: $c" >&2
        failed+=("$name")
        return 0
      fi
    done
  }
  echo 'aayu-gate: NOT RUN LOCALLY: CI job "changes" runs only in CI: it picks the jobs a pull request needs from the paths it changes; the local gate runs every job'
  job 'build' 'go build ./... && go vet ./... && go test -coverprofile="$GATE_TMP/coverage.out" ./...' 'go run ./internal/ratchet/cmd/ratchet -coverprofile "$GATE_TMP/coverage.out" -base "$(git merge-base origin/dev HEAD)"' 'go run ./internal/evals/cmd/eval -evolve-gate -base "$(git merge-base origin/dev HEAD)" -head HEAD -branch "$(git branch --show-current)"' 'CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o "$GATE_TMP/aayudha" ./cmd/aayudha && size=$(wc -c < "$GATE_TMP/aayudha") && echo "host binary: $size bytes (budget 60000000)" && [ "$size" -le 60000000 ]'
  echo 'aayu-gate: NOT RUN LOCALLY: part of CI job "build": the binaries for the other five platforms are built and measured against the 60 MB budget only in CI'
  job 'generate-drift' 'd="$GATE_TMP/drift"; GIT_LFS_SKIP_SMUDGE=1 git worktree add --quiet --detach "$d" HEAD; trap '\''git worktree remove --force "$d"'\'' EXIT; cd "$d"; go generate ./...; drift=$(git status --porcelain --untracked-files=all); if [ -n "$drift" ]; then echo "generated files in the pushed commit are out of date: run go generate ./... and commit the result; do not edit generated files by hand"; echo "$drift"; exit 1; fi; go generate ./...; if [ -n "$(git status --porcelain --untracked-files=all)" ]; then echo "a second go generate run changed files; generators must be deterministic"; exit 1; fi'
  job 'lint' 'go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.14.0 run ./...'
  job 'commits' 'cc='\''^(feat|fix|docs|refactor|test|build|ci|chore|perf|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].*'\''; fail=0; for sha in $(git rev-list --no-merges "$(git merge-base origin/dev HEAD)..HEAD"); do subject=$(git log -1 --format=%s "$sha"); email=$(git log -1 --format=%ae "$sha"); if ! grep -qE "$cc" <<<"$subject"; then echo "$sha: subject is not a Conventional Commit: $subject"; fail=1; fi; if ! git log -1 --format=%B "$sha" | grep -iE '\''^Signed-off-by: .+ <[^>]+>$'\'' | grep -qiF "<$email>"; then echo "$sha: no DCO Signed-off-by trailer for the author <$email>: use git commit -s; fix with git rebase --signoff origin/dev"; fail=1; fi; done; exit "$fail"'
  echo 'aayu-gate: NOT RUN LOCALLY: part of CI job "commits": the pull request title (the squash subject) is checked only in CI'
  job 'security' 'if have gitleaks; then gitleaks git . --redact --no-banner --log-opts=HEAD; fi' 'if have semgrep; then semgrep scan --config p/golang --config p/secrets --config p/github-actions --error --metrics=off; fi' 'if have osv-scanner; then osv-scanner scan source -r .; fi' 'if have gitleaks && have semgrep && have osv-scanner; then AAYU_FLOOR_TOOLS=1 go test ./internal/verify -run TestFloorsWithRealTools -count=1; fi' 'go run github.com/google/go-licenses/v2@v2.0.1 check ./... --allowed_licenses=0BSD,Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,MIT' 'allowed=0BSD,Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,MIT; pnpm install --frozen-lockfile --ignore-scripts --silent; found=$(pnpm licenses list --recursive --prod --json | jq -r '\''keys[]'\''); bad=$(grep -vxF -f <(tr '\'','\'' '\''\n'\'' <<<"$allowed") <<<"$found" || true); if [ -n "$bad" ]; then echo "npm licences not on the allow list: $bad"; exit 1; fi'
  job 'docs' 'npx --yes markdownlint-cli2@0.23.2 "**/*.md" "#.aayudha/worktrees/**"' 'if have lychee; then lychee --no-progress --max-retries 3 --include-fragments '\''./**/*.md'\''; fi'
  job 'release-snapshot' 'if have goreleaser; then goreleaser check; fi'
  echo 'aayu-gate: NOT RUN LOCALLY: part of CI job "release-snapshot": the signed snapshot build needs the workflow OIDC token for keyless cosign signing, and the install.sh tests run against that snapshot'
  echo 'aayu-gate: NOT RUN LOCALLY: CI job "protected-paths" runs only in CI: it reads the pull request CODEOWNER reviews from GitHub: a protected path needs an approval or the founder recorded bypass'
  if [ ${#failed[@]} -gt 0 ]; then
    echo "aayu-gate: failed CI jobs: ${failed[*]}" >&2
    exit 1
  fi
  echo "aayu-gate ok: every required CI job that can run here passed"
  exit 0
fi
step 'go build ./...'
go build ./...
step 'go test ./...'
go test ./...
step 'pnpm -r --if-present run test'
pnpm -r --if-present run test
