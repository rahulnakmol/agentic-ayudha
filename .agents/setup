#!/usr/bin/env bash
# Generated by `aayu install --env` from .aayudha/env.toml (environment sha256:b6655dfa4a0f5c48).
# The one setup script every agent host runs: Amp natively, Cursor (.cursor/environment.json install),
# Codex cloud (Install script field), and Claude Code on the web (SessionStart hook in .claude/settings.json).
# Idempotent and non-interactive; it leaves no process running (no host keeps them).
# Change the spec and rerun `aayu install --env --apply`; do not edit this file.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { echo "==> [$(date +%H:%M:%S)] $*"; }
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n env "PATH=/usr/local/sbin:/usr/sbin:/sbin:$PATH" "$@"; fi; }
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]; }
in_ranges() { # version "lo [hi]"...: half-open ranges
  local v=$1 r lo hi
  shift
  for r in "$@"; do
    lo=${r%% *}; hi=
    [ "$r" = "$lo" ] || hi=${r#* }
    if version_ge "$v" "$lo" && { [ -z "$hi" ] || ! version_ge "$v" "$hi"; }; then return 0; fi
  done
  return 1
}
export DEBIAN_FRONTEND=noninteractive COREPACK_ENABLE_DOWNLOAD_PROMPT=0
case "$(uname -m)" in
  x86_64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "aayu-env: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac
apt_updated=
need_apt() { # installs only the missing packages, so a warm run makes no apt call
  local p missing=()
  for p in "$@"; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "install ok installed" || missing+=("$p")
  done
  [ ${#missing[@]} -eq 0 ] && return 0
  step "apt: ${missing[*]}"
  if [ -z "$apt_updated" ]; then as_root apt-get update -qq; apt_updated=1; fi
  as_root apt-get install -y -qq --no-install-recommends "${missing[@]}"
}
fetch() { # url sha256 file: every download is checked against a pinned SHA-256
  curl -fsSL --retry 3 -o "$3" "$1"
  echo "$2  $3" | sha256sum -c --quiet -
}
path_first() { # a directory that must win in later shells too (Codex runs setup in its own shell)
  persist_line "export PATH=\"$1:\$PATH\""
  export PATH="$1:$PATH"
}
persist() { persist_line "export $1"; } # a variable later shells need
persist_line() { # Claude Code's Bash tool reads CLAUDE_ENV_FILE, not the shell profile
  local rc
  for rc in "$HOME/.bashrc" "$HOME/.profile" ${CLAUDE_ENV_FILE:+"$CLAUDE_ENV_FILE"}; do
    grep -qxF "$1" "$rc" 2>/dev/null || echo "$1" >> "$rc"
  done
}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

step "System packages"
need_apt ca-certificates curl git xz-utils age git-lfs

GO_VERSION=1.27.2 # go.mod:3 (go 1.25.0)
step "Go $GO_VERSION"
if [ "$(GOTOOLCHAIN=local /usr/local/go/bin/go env GOVERSION 2> /dev/null)" != "go$GO_VERSION" ]; then
  installed=
  # A Go already on the machine fetches the exact toolchain through the module proxy, checked against
  # the Go checksum database (proxy.golang.org is on every host's default allowlist; dl.google.com is not).
  if command -v go > /dev/null 2>&1 && goroot=$(GOTOOLCHAIN="go$GO_VERSION" GOFLAGS= go env GOROOT 2> /dev/null) &&
    [ "$(GOTOOLCHAIN=local "$goroot/bin/go" env GOVERSION 2> /dev/null)" = "go$GO_VERSION" ]; then
    as_root rm -rf /usr/local/go.aayu && as_root cp -a "$goroot" /usr/local/go.aayu
    as_root rm -rf /usr/local/go && as_root mv /usr/local/go.aayu /usr/local/go && as_root chmod -R u+w /usr/local/go
    installed=1
  fi
  if [ -z "$installed" ]; then
    case "$ARCH" in
      amd64) sum=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5 ;;
      arm64) sum=94f3e30b8e374bc285e7dadc11e0865726b9bc6e85b841ccceaabc0214c6b7c8 ;;
    esac
    fetch "https://dl.google.com/go/go$GO_VERSION.linux-$ARCH.tar.gz" "$sum" "$tmp/go.tar.gz"
    as_root rm -rf /usr/local/go
    as_root tar -C /usr/local -xzf "$tmp/go.tar.gz"
  fi
fi
as_root ln -sf /usr/local/go/bin/go /usr/local/go/bin/gofmt /usr/local/bin/
hash -r
# A GOROOT set for another Go (codex-universal's mise sets one) would make this go compile with that one's tools.
if [ -n "${GOROOT:-}" ] && [ "$GOROOT" != /usr/local/go ]; then persist GOROOT=/usr/local/go; export GOROOT=/usr/local/go; fi
[ "$(GOTOOLCHAIN=local go env GOVERSION)" = "go$GO_VERSION" ] || path_first /usr/local/go/bin
go version

NODE_VERSION=22.23.3 # package.json engines.node (^22.12.0 || ^24.0.0 || >=26.0.0)
node_ok() { command -v node > /dev/null 2>&1 && in_ranges "$(node --version | sed 's/^v//')" "22.12.0 23.0.0" "24.0.0 25.0.0" "26.0.0"; }
step "Node.js (accepts ^22.12.0 || ^24.0.0 || >=26.0.0; installs $NODE_VERSION when none fits)"
if ! node_ok; then
  case "$ARCH" in
    amd64) sum=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de name=x64 ;;
    arm64) sum=a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f name=arm64 ;;
  esac
  fetch "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$name.tar.xz" "$sum" "$tmp/node.tar.xz"
  as_root tar -C /usr/local --strip-components=1 --no-same-owner -xJf "$tmp/node.tar.xz" --exclude='*.md' --exclude=LICENSE
  hash -r
  node_ok || path_first /usr/local/bin
fi
node --version

step "pnpm 12.0.0 through corepack" # package.json packageManager (pnpm@12.0.0)
persist COREPACK_ENABLE_DOWNLOAD_PROMPT=0
if ! [ "$(pnpm --version 2> /dev/null)" = "12.0.0" ]; then
  if ! command -v corepack > /dev/null 2>&1 || ! version_ge "$(corepack --version)" "0.36.0"; then
    if [ -w "$(npm prefix -g)/lib" ]; then npm install -g --no-fund --no-audit "corepack@0.36.0"; else as_root npm install -g --no-fund --no-audit "corepack@0.36.0"; fi
    hash -r
  fi
  cpdir=$(dirname "$(command -v corepack)")
  if [ -w "$cpdir" ]; then corepack enable pnpm; else as_root corepack enable pnpm; fi
  hash -r
fi
pnpm --version

step 'Dependencies: go mod download' # go.sum
go mod download

step 'Dependencies: pnpm install --frozen-lockfile' # package.json packageManager (pnpm@12.0.0)
pnpm install --frozen-lockfile

step 'Browsers: pnpm --filter @aayudha/design-system exec playwright install --with-deps chromium' # packages/design-system/package.json depends on playwright
pnpm --filter @aayudha/design-system exec playwright install --with-deps chromium

step 'Step: if ! version_ge "$(git version | cut -d'\'' '\'' -f3)" 2.40; then need_apt build-essential libcurl4-gnutls-dev libexpat1-dev libssl-dev zlib1g-dev; t=$(mktemp -d); curl -fsSL https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.55.0.tar.xz -o "$t/git.tar.xz"; echo "457fdb04dc8728e007d4688695e6912e6f680727920f2a40bf11eacc17505357  $t/git.tar.xz" | sha256sum -c --quiet -; tar -xJf "$t/git.tar.xz" -C "$t"; make -s -C "$t/git-2.55.0" -j"$(nproc)" prefix=/usr/local NO_RUST=1 NO_TCLTK=1 NO_GETTEXT=1 all > /dev/null; as_root make -s -C "$t/git-2.55.0" prefix=/usr/local NO_RUST=1 NO_TCLTK=1 NO_GETTEXT=1 install > /dev/null; rm -rf "$t"; hash -r; fi' # answer steps (human)
if ! version_ge "$(git version | cut -d' ' -f3)" 2.40; then need_apt build-essential libcurl4-gnutls-dev libexpat1-dev libssl-dev zlib1g-dev; t=$(mktemp -d); curl -fsSL https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.55.0.tar.xz -o "$t/git.tar.xz"; echo "457fdb04dc8728e007d4688695e6912e6f680727920f2a40bf11eacc17505357  $t/git.tar.xz" | sha256sum -c --quiet -; tar -xJf "$t/git.tar.xz" -C "$t"; make -s -C "$t/git-2.55.0" -j"$(nproc)" prefix=/usr/local NO_RUST=1 NO_TCLTK=1 NO_GETTEXT=1 all > /dev/null; as_root make -s -C "$t/git-2.55.0" prefix=/usr/local NO_RUST=1 NO_TCLTK=1 NO_GETTEXT=1 install > /dev/null; rm -rf "$t"; hash -r; fi

step "Setup complete (environment sha256:b6655dfa4a0f5c48)"
