{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProofObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<bucket>/r/proof/o/r/*"
    },
    {
      "Sid": "ProofRetention",
      "Effect": "Allow",
      "Action": ["s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration"],
      "Resource": "arn:aws:s3:::<bucket>"
    }
  ]
}
