{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueryRumLogGroup",
      "Effect": "Allow",
      "Action": "logs:StartQuery",
      "Resource": "arn:aws:logs:<region>:<account-id>:log-group:/aws/vendedlogs/RUMService_<monitor>*"
    },
    {
      "Sid": "ReadQueryResults",
      "Effect": "Allow",
      "Action": "logs:GetQueryResults",
      "Resource": "*"
    },
    {
      "Sid": "ReadRum",
      "Effect": "Allow",
      "Action": ["rum:GetAppMonitor", "rum:GetAppMonitorData"],
      "Resource": "arn:aws:rum:<region>:<account-id>:appmonitor/<monitor>"
    },
    {
      "Sid": "ProveReadOnly",
      "Effect": "Allow",
      "Action": "iam:SimulatePrincipalPolicy",
      "Resource": "arn:aws:iam::<account-id>:role/aayudha-read-{{.Name}}"
    }
  ]
}
