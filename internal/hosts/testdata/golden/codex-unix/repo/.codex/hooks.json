    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"/opt/aayudha/bin/aayu\" hook pre-tool --host codex",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
