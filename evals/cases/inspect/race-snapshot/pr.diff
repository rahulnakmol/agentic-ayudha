@@ -1,6 +1,10 @@
 package metrics
 
-import "sync"
+import (
+	"encoding/json"
+	"net/http"
+	"sync"
+)
 
 // Counter counts named events. It is safe for concurrent use.
 type Counter struct {
@@ -17,3 +21,18 @@ func (c *Counter) Inc(name string) {
 	c.n[name]++
 	c.mu.Unlock()
 }
+
+// Snapshot returns a copy of every count.
+func (c *Counter) Snapshot() map[string]int {
+	out := make(map[string]int, len(c.n))
+	for k, v := range c.n {
+		out[k] = v
+	}
+	return out
+}
+
+// Handler serves GET /metrics as a JSON object of counts.
+func (c *Counter) Handler(w http.ResponseWriter, _ *http.Request) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(c.Snapshot())
+}
