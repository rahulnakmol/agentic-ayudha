@@ -0,0 +1,38 @@
+package rates
+
+import (
+	"context"
+	"errors"
+	"time"
+)
+
+// maxWait caps the wait between two tries.
+const maxWait = 30 * time.Second
+
+// Retry calls f up to attempts times, waiting base, then twice as long each
+// time (at most maxWait), and stops early when ctx is done. It returns nil on
+// the first success, ctx's error when cancelled, else f's last error.
+func Retry(ctx context.Context, attempts int, base time.Duration, f func(context.Context) error) error {
+	if attempts < 1 {
+		return errors.New("rates: attempts must be at least 1")
+	}
+	var err error
+	wait := base
+	for i := 0; i < attempts; i++ {
+		if err = f(ctx); err == nil {
+			return nil
+		}
+		if i == attempts-1 {
+			break
+		}
+		t := time.NewTimer(wait)
+		select {
+		case <-ctx.Done():
+			t.Stop()
+			return ctx.Err()
+		case <-t.C:
+		}
+		wait = min(wait*2, maxWait)
+	}
+	return err
+}
diff --git a/internal/rates/retry_test.go b/internal/rates/retry_test.go
new file mode 100644
index 0000000..0e11c5b
--- /dev/null
+++ b/internal/rates/retry_test.go
@@ -0,0 +1,41 @@
+package rates
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestRetrySucceedsOnThirdCall(t *testing.T) {
+	calls := 0
+	err := Retry(context.Background(), 3, time.Millisecond, func(context.Context) error {
+		calls++
+		if calls < 3 {
+			return errors.New("busy")
+		}
+		return nil
+	})
+	if err != nil || calls != 3 {
+		t.Fatalf("err %v after %d calls", err, calls)
+	}
+}
+
+func TestRetryStopsWhenCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	calls := 0
+	err := Retry(ctx, 3, time.Second, func(context.Context) error {
+		calls++
+		cancel()
+		return errors.New("busy")
+	})
+	if !errors.Is(err, context.Canceled) || calls != 1 {
+		t.Fatalf("err %v after %d calls", err, calls)
+	}
+}
+
+func TestRetryNeedsAnAttempt(t *testing.T) {
+	if err := Retry(context.Background(), 0, time.Millisecond, nil); err == nil {
+		t.Fatal("0 attempts accepted")
+	}
+}
