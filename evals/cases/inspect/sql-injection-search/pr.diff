+package orders
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// Search returns the orders whose customer name contains q, by ID.
+func Search(ctx context.Context, db *sql.DB, q string) ([]Order, error) {
+	query := fmt.Sprintf("SELECT id, customer, total FROM orders WHERE customer LIKE '%%%s%%' ORDER BY id", q)
+	rows, err := db.QueryContext(ctx, query)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []Order
+	for rows.Next() {
+		var o Order
+		if err := rows.Scan(&o.ID, &o.Customer, &o.Total); err != nil {
+			return nil, err
+		}
+		out = append(out, o)
+	}
+	return out, rows.Err()
+}
+
+// SearchHandler serves GET /orders?q=<text>.
+func SearchHandler(db *sql.DB) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		os, err := Search(r.Context(), db, r.URL.Query().Get("q"))
+		if err != nil {
+			http.Error(w, "search failed", http.StatusInternalServerError)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(os)
+	}
+}
