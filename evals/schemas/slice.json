{
  "$comment": "A slice draft (WP5.4): the stories the host's model sliced from a Feature or an XL story, checked by `aayu slice --draft`.",
  "type": "object",
  "required": [
    "feature",
    "stories"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "integer",
      "minimum": 1
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "fields",
          "labels",
          "paths"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+:[A-Za-z0-9-]+$"
            }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
