{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "aayu hook session-start --host cursor --skills 0.0.0"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "aayu hook pre-tool --host cursor --skills 0.0.0"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "aayu hook pre-tool --host cursor --skills 0.0.0"
      }
    ],
    "afterShellExecution": [
      {
        "command": "aayu hook post-tool --host cursor --skills 0.0.0"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "aayu hook post-tool --host cursor --skills 0.0.0"
      }
    ]
  }
}
