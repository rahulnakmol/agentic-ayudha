{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aayu hook session-start --skills 0.0.0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "aayu hook pre-tool --skills 0.0.0"
          }
        ]
      }
    ]
  }
}
