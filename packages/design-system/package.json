{
  "name": "@aayudha/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Aayudha design system: semantic tokens, density modes, shadcn primitives, floorplans, SwiftUI and Compose token export.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./motion": "./src/motion/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "gsap": "^3.15.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
