{
  "$description": "Aayudha semantic tokens: the single source for the CSS, SwiftUI, and Compose exports (scripts/build-tokens.ts). Token names are semantic in the spirit of OpenUI5 theming parameters (brand, shell, field, list, positive/negative/critical/informative), but the names, structure, and values are Aayudha's own; no SAP theme files, icons, or fonts are used. Dimensions are px (CSS emits rem at 16 px, SwiftUI points, Compose dp/sp). Durations are ms. Everything except the `web` group is exported to every platform under the same name.",
  "color": {
    "background": { "$type": "color", "$value": "#f5f6f8", "$description": "Page background behind surfaces." },
    "surface": { "$type": "color", "$value": "#ffffff", "$description": "Cards, tiles, tables, dialogs, popovers." },
    "border": { "$type": "color", "$value": "#dde1e7", "$description": "Decorative separators and container borders." },
    "overlay": { "$type": "color", "$value": "#1b233066", "$description": "Scrim behind modal dialogs." },
    "focus": { "$type": "color", "$value": "#1f5bd1", "$description": "Keyboard focus ring." },
    "shell": {
      "background": { "$type": "color", "$value": "#ffffff", "$description": "Application shell bar." },
      "border": { "$type": "color", "$value": "#d5dae1", "$description": "Shell bar bottom edge." }
    },
    "brand": {
      "default": { "$type": "color", "$value": "#1f5bd1", "$description": "Emphasised actions, links, selected indicators." },
      "hover": { "$type": "color", "$value": "#184aae", "$description": "Emphasised action on hover." },
      "contrast": { "$type": "color", "$value": "#ffffff", "$description": "Text and icons on brand." }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#eaeef3", "$description": "Secondary (ghost-filled) actions and chips." },
      "contrast": { "$type": "color", "$value": "#1b2330", "$description": "Text and icons on accent." }
    },
    "text": {
      "default": { "$type": "color", "$value": "#1b2330", "$description": "Body text." },
      "label": { "$type": "color", "$value": "#4f5a6b", "$description": "Field labels, secondary text, table headers." },
      "placeholder": { "$type": "color", "$value": "#626c7c", "$description": "Input placeholders." }
    },
    "field": {
      "background": { "$type": "color", "$value": "#ffffff", "$description": "Input, select, and checkbox background." },
      "border": { "$type": "color", "$value": "#7d8696", "$description": "Input borders (meets 3:1 non-text contrast on surface)." }
    },
    "list": {
      "hover": { "$type": "color", "$value": "#eef2f8", "$description": "Hovered row or item." },
      "selected": { "$type": "color", "$value": "#e3ebfb", "$description": "Selected row or item." },
      "header": { "$type": "color", "$value": "#f7f8fa", "$description": "Table and list header background." }
    },
    "positive": {
      "default": { "$type": "color", "$value": "#1c7639", "$description": "Success text and icons." },
      "background": { "$type": "color", "$value": "#e7f4ec", "$description": "Success badge and message background." }
    },
    "negative": {
      "default": { "$type": "color", "$value": "#bf2828", "$description": "Error text, icons, destructive actions." },
      "background": { "$type": "color", "$value": "#fbeaea", "$description": "Error badge and message background." }
    },
    "critical": {
      "default": { "$type": "color", "$value": "#8f4600", "$description": "Warning text and icons." },
      "background": { "$type": "color", "$value": "#fdf0e1", "$description": "Warning badge and message background." }
    },
    "informative": {
      "default": { "$type": "color", "$value": "#0b62a0", "$description": "Information text and icons." },
      "background": { "$type": "color", "$value": "#e6f1fa", "$description": "Information badge and message background." }
    },
    "neutral": {
      "default": { "$type": "color", "$value": "#535c69", "$description": "Neutral status text and icons." },
      "background": { "$type": "color", "$value": "#eef0f3", "$description": "Neutral badge background." }
    }
  },
  "font": {
    "size": {
      "small": { "$type": "dimension", "$value": 12, "$description": "Captions, badges, helper text." },
      "body": { "$type": "dimension", "$value": 14, "$description": "Default text." },
      "large": { "$type": "dimension", "$value": 16, "$description": "Emphasised body, section titles." },
      "header-3": { "$type": "dimension", "$value": 20, "$description": "Card and dialog titles." },
      "header-2": { "$type": "dimension", "$value": 24, "$description": "Object and page titles." },
      "header-1": { "$type": "dimension", "$value": 32, "$description": "Initial-page headline." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": 8, "$description": "Buttons, inputs, badges." },
    "container": { "$type": "dimension", "$value": 12, "$description": "Cards, dialogs, panels." }
  },
  "motion": {
    "duration": {
      "short": { "$type": "duration", "$value": 150, "$description": "Hover and press feedback." },
      "medium": { "$type": "duration", "$value": 250, "$description": "Panels, dialogs, list insertions." },
      "long": { "$type": "duration", "$value": 400, "$description": "Page and column transitions." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "Elements moving within the screen." },
      "enter": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1], "$description": "Elements entering the screen." },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1], "$description": "Elements leaving the screen." }
    }
  },
  "density": {
    "$description": "Density modes. Every mode defines the same names. Web: data-density=\"cozy\" (default, touch) or \"compact\" (pointer) on any ancestor.",
    "cozy": {
      "size": {
        "control-height": { "$type": "dimension", "$value": 44, "$description": "Buttons, inputs, selects, tabs." },
        "row-height": { "$type": "dimension", "$value": 48, "$description": "Table and list rows." },
        "icon": { "$type": "dimension", "$value": 20, "$description": "Icons inside controls." }
      },
      "space": {
        "control-inline": { "$type": "dimension", "$value": 16, "$description": "Horizontal padding inside controls." },
        "gap": { "$type": "dimension", "$value": 12, "$description": "Gap between related controls." },
        "section": { "$type": "dimension", "$value": 24, "$description": "Padding inside cards and sections." },
        "page": { "$type": "dimension", "$value": 32, "$description": "Horizontal page padding." }
      }
    },
    "compact": {
      "size": {
        "control-height": { "$type": "dimension", "$value": 32, "$description": "Buttons, inputs, selects, tabs." },
        "row-height": { "$type": "dimension", "$value": 32, "$description": "Table and list rows." },
        "icon": { "$type": "dimension", "$value": 16, "$description": "Icons inside controls." }
      },
      "space": {
        "control-inline": { "$type": "dimension", "$value": 12, "$description": "Horizontal padding inside controls." },
        "gap": { "$type": "dimension", "$value": 8, "$description": "Gap between related controls." },
        "section": { "$type": "dimension", "$value": 16, "$description": "Padding inside cards and sections." },
        "page": { "$type": "dimension", "$value": 16, "$description": "Horizontal page padding." }
      }
    }
  },
  "web": {
    "$description": "Web-only tokens. Not exported: SwiftUI and Compose use the platform system font.",
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" },
        "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
      }
    }
  }
}
